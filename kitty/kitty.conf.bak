# Nazuna Nanakusa Theme - Kitty Config
# ~/.config/kitty/kitty.conf

# Font configuration
font_family      JetBrains Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 12.0

# Cursor
cursor_shape beam
cursor_beam_thickness 1.5
cursor_blink_interval 0.5
cursor_stop_blinking_after 15.0

# Scrollback
scrollback_lines 10000
scrollback_pager less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER

# Mouse
mouse_hide_wait 3.0
# url_color #7b68ee
url_style curly
detect_urls yes

# Performance
repaint_delay 10
input_delay 3
sync_to_monitor yes

# Bell
enable_audio_bell no
visual_bell_duration 0.0
window_alert_on_bell yes

# Window layout
remember_window_size  yes
initial_window_width  640
initial_window_height 400
enabled_layouts splits,stack
window_resize_step_cells 2
window_resize_step_lines 2
window_border_width 1.5pt
draw_minimal_borders yes
window_margin_width 4
single_window_margin_width 0
window_padding_width 8
placement_strategy center

# Tab bar
tab_bar_edge top
tab_bar_margin_width 0.0
tab_bar_margin_height 8.0 4.0
tab_bar_style fade
tab_bar_min_tabs 2
tab_fade 0.25 0.5 0.75 1
tab_title_template "{fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab}{index}:{title}"

# Color scheme - Nazuna Nanakusa
# Based on her purple/pink/night aesthetic

# Basic colors
background_opacity 0.9
enable_background_blur yes
background_blur 1
# foreground #ddd6f3
# background #000000
# selection_foreground #ffffff
# selection_background #b968c7

# Cursor colors
# cursor #ffaac6
# cursor_text_color #16141f

# URL underline color
# url_color #7b68ee

# Tab bar colors
# active_tab_foreground   #ffffff
# active_tab_background   #b968c7
# inactive_tab_foreground #9d9daf
# inactive_tab_background #2d2a4e
# tab_bar_background      #1b192e

# Window border colors
# active_border_color   #b968c7
# inactive_border_color #2d2a4e
# bell_border_color     #ff6b9d

# Black
# color0 #16141f
# color8 #2d2a4e

# Red
# color1 #ff6b9d
# color9 #ff85b3

# Green
# color2  #a6e3a1
# color10 #b8f1b0

# Yellow
# color3  #ffd866
# color11 #ffe799

# Blue
# color4  #7b68ee
# color12 #9d8aff

# Magenta/Purple - Nazuna's signature color
# color5  #b968c7
# color13 #d68ef5

# Cyan
# color6  #89dceb
# color14 #a8e8f7

# White
# color7  #ddd6f3
# color15 #ffffff

# Advanced
shell .
editor .
confirm_os_window_close 0
close_on_child_death no
allow_remote_control no
update_check_interval 0

# OS specific tweaks
linux_display_server auto

# Keyboard shortcuts
kitty_mod ctrl+shift

# Clipboard
map kitty_mod+c copy_to_clipboard
map kitty_mod+v paste_from_clipboard

# Window management
map kitty_mod+enter new_window
map kitty_mod+w close_window
map kitty_mod+] next_window
map kitty_mod+[ previous_window

# Tab management
map kitty_mod+t new_tab
map kitty_mod+q close_tab
map kitty_mod+right next_tab
map kitty_mod+left previous_tab

# Font sizes
map kitty_mod+equal  change_font_size all +2.0
map kitty_mod+minus  change_font_size all -2.0
map kitty_mod+0      change_font_size all 0

# Miscellaneous
map kitty_mod+f11 toggle_fullscreen
map kitty_mod+u    kitten unicode_input
allow_remote_control yes


# BEGIN_KITTY_THEME
# Rosé Pine
include current-theme.conf
# END_KITTY_THEME
