{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 0,
      "right": 2,
      "left": 0
    }
  },
  "modules": [
  {
    "type":"title",
    "format": "{host-name}",
    "key": "Hostname",
    "keyColor": "#fc00c3"
  },
  {
    "type": "board",
    "format": "{1}",
    "key": "PC",
    "keyColor": "#e612b5"
  },
  {
    "type": "os",
    "key": "OS",
    "keyColor": "#f70ac4"
  },
  {
    "type": "kernel",
    "key": "Kernel version", 
    "keyColor": "#c41fa1"
  },
  {
    "type": "terminal",
    "key": "Terminal",
    "keyColor": "#b31eab"
  },
  {  
    "type": "wm",
    "key": "Window Manager",
    "keyColor": "#c212e6"
  },
  {
    "type": "uptime",
    "key": "Uptime",
    "keyColor": "#962791"
  },
  {
    "type": "cpu",
    "key": "CPU",
    "keyColor": "#a123ba"
  },
    {
    "type": "gpu",
    "key": "GPU",
    "keyColor": "#b968c7"
  },
  {
    "type": "memory",
    "key": "RAM:",
    "keyColor": "#813f8f"
  }
  ] 
}
